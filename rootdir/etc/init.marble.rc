service vendor.nfc_hal_service /vendor/bin/hw/android.hardware.nfc-service.nxp
    class early_hal
    user nfc
    group nfc
    override
    disabled

service secureelement-hal_1_2 /vendor/bin/hw/vendor.qti.secure_element@1.2-service
    class early_hal
    user system
    group system
    override
    disabled

service qti_esepowermanager_service_1_1 /vendor/bin/hw/vendor.qti.esepowermanager@1.1-service
    class early_hal
    user system
    group nfc system
    override
    disabled

# Do not enable NFC on marblein
on property:ro.boot.product.hardware.sku=marble
    enable vendor.nfc_hal_service
    enable secureelement-hal_1_2
    enable qti_esepowermanager_service_1_1

service mfp-daemon /vendor/bin/hw/mfp-daemon
    override
    class late_start
    user system
    group system drmrpc diag input uhid
    capabilities SYS_NICE

on boot
    write /dev/cpuctl/top-app/cpu.uclamp.min 10
    write /dev/cpuctl/top-app/cpu.uclamp.max 100
    write /dev/stune/top-app/schedtune.boost 10
    write /dev/stune/top-app/schedtune.boost 10
   # GPU boost
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq 270000000
    write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq 580000000
on property:sys.boot_completed=1
    # GPU low profile
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq 180000000
    # schduler tuning
    write /proc/sys/kernel/sched_downmigrate 65
    write /proc/sys/kernel/sched_upmigrate 75
    # cpu touch boost
    write /sys/module/cpu_boost/parameters/input_boost_freq "0:1248000 1:1248000"
    write /sys/module/cpu_boost/parameters/input_boost_ms 140
